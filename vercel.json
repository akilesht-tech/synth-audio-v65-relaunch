{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/**,public/**}",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?__path=/api/$1" },
    { "source": "/api", "destination": "/api/index.js?__path=/api" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js?__path=/uploads/$1" }
  ]
}
