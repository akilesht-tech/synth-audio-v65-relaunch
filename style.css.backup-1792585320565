  transform: translateY(-2px);
}

.coverWrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 4px;
  overflow: hidden;
  background: #15151c;
}
.cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cardplay {
  position: absolute;
  right: 5px;
  bottom: 5px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--accent-purple);
  color: #fff;
  display: grid;
  place-items: center;
  opacity: 0;
