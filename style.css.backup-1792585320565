    display: flex !important;
  }

  .headerSearch {
    display: none !important;
  }

  .topProfileName {
    display: none !important;
  }

  .topProfileBtn {
    padding: 3px !important;
    background: transparent !important;
    border-color: transparent !important;
  }

  .headerSearch kbd {
