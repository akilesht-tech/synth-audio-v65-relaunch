    transition: color 0.15s ease;
  }
  .mnav svg {
    width: 22px;
    height: 22px;
  }
  .mnav.active {
    color: var(--accent-purple-light);
  }

  /* Mini Player on Mobile — Streamlined, Compact & Docked Above MobileNav */
  #player {
