/* ==========================================================================
   PRO ADMIN UPLOAD PANEL & STEP PROGRESSION STYLES
   ========================================================================== */
.adminUploadPro {
  background: var(--bg-surface);
  border: 1px solid var(--border-medium);
  border-radius: var(--radius-lg);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.uploadStepBar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px;
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  margin-bottom: 4px;
  overflow-x: auto;
}
.uploadStep {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-muted);
  white-space: nowrap;
  transition: all 0.2s ease;
}
.uploadStep .stepNum {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: grid;
  place-items: center;
  font-size: 11.5px;
  color: var(--text-secondary);
}
.uploadStep.active {
  color: var(--accent-purple-light);
}
.uploadStep.active .stepNum {
  background: var(--accent-purple);
  color: #fff;
  box-shadow: 0 0 10px rgba(var(--accent-rgb, 125, 59, 102), 0.5);
}
.uploadStep.completed {
  color: var(--accent-emerald);
}
.uploadStep.completed .stepNum {
  background: var(--accent-emerald);
  color: #fff;
}
.uploadStepArrow {
  color: var(--border-medium);
  font-size: 16px;
  margin: 0 4px;
}

.proDropZone {
  padding: 32px 20px;
  border: 2px dashed rgba(var(--accent-rgb, 125, 59, 102), 0.35);
  border-radius: var(--radius-md);
  background: rgba(var(--accent-rgb, 125, 59, 102), 0.03);
  text-align: center;
  cursor: pointer;
  transition: all 0.2s ease;
}
.proDropZone:hover, .proDropZone.dragging {
  border-color: var(--accent-purple);
  background: rgba(var(--accent-rgb, 125, 59, 102), 0.08);
}
.proDropZone .uploadIcon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(var(--accent-rgb, 125, 59, 102), 0.15);
  color: var(--accent-purple-light);
  display: grid;
  place-items: center;
  margin: 0 auto 12px;
}
.proDropZone .uploadIcon svg {
  width: 24px;
  height: 24px;
}

.selectedAudio {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: rgba(var(--accent-rgb, 125, 59, 102), 0.08);
  border: 1px solid rgba(var(--accent-rgb, 125, 59, 102), 0.25);
  border-radius: var(--radius-md);
}
.selectedAudio.hidden { display: none; }
.selectedAudio .selectedIcon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--accent-purple);
  color: #fff;
  display: grid;
  place-items: center;
  margin-right: 12px;
  flex-shrink: 0;
}
.selectedAudio .selectedInfo {
  min-width: 0;
  flex: 1;
}
.selectedAudio .selectedInfo b {
  display: block;
  font-size: 14px;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.selectedAudio .selectedInfo small {
  font-size: 12px;
  color: var(--accent-purple-light);
}
.clearSelectedBtn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--text-muted);
