/* ==========================================================================
   Artwork Presentation & Smooth Loading Placeholders
   ========================================================================== */
.miniArtWrap, .fpcoverWrap {
  background: var(--grad-surface, #10121a);
  position: relative;
  overflow: hidden;
}
.miniart, .fpcover {
  transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s ease;
}
.miniart.artLoading, .fpcover.artLoading {
  opacity: 0.35;
  transform: scale(0.98);
}

/* ==========================================================================
   Restrained Luxury Entry Animations & Reduced Motion
   ========================================================================== */
@keyframes auroraFadeInUp {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes auroraScaleIn {
  from {
    opacity: 0;
    transform: scale(0.97);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.pageIntro, .section, .adminPage, .searchSection, .albumDetail, .playlistHead {
  animation: auroraFadeInUp 0.26s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.songcard, .albumcard, .artistcard, .playlistCard, .genreCard {
  animation: auroraFadeInUp 0.22s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.modalbox, .actionSheet, .contextMenu {
  animation: auroraScaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}


/* ==========================================================================
   GLASSMORPHISM SYSTEM ENHANCEMENTS & ACCESSIBLE FALLBACKS
   Comprehensive Translucent Frosted Glass Architecture
   ========================================================================== */

/* Universal Frosted Glass Utility Classes */
.glass-panel {
  background: var(--glass-card) !important;
  backdrop-filter: blur(16px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(16px) saturate(180%) !important;
  border: 1px solid var(--glass-border-subtle) !important;
  box-shadow: var(--glass-shadow), var(--glass-highlight) !important;
}

.glass-pill {
  background: rgba(255, 255, 255, 0.06) !important;
  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
  border: 1px solid var(--glass-border-subtle) !important;
  transition: all 0.2s ease !important;
}
.glass-pill:hover {
  background: rgba(var(--accent-rgb, 125, 59, 102), 0.22) !important;
  border-color: var(--glass-border-accent) !important;
}

/* Accessible Fallback when backdrop-filter is unsupported */
@supports not ((-webkit-backdrop-filter: blur(10px)) or (backdrop-filter: blur(10px))) {
  .side, .modalbox, .loginbox, .card, .homeHeroCard, .resumeCard, .searchbox,
  .emptyStateCard, .accountCard, .settingRow, .adminHero, .adminStat,
  .uploadSectionCard, .proDropZone, .bottom.appleMini.compactMini {
    background: #12141c !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
  }
}

/* Reduced Motion Accessibility */
@media (prefers-reduced-motion: reduce) {
  .card, .songrow, .resumeCard, .btn, .fpTopCircleBtn, .fpPillBtn,
  .palette-dot, .modalbox, .homeHeroCard, .proDropZone {
    transition: none !important;
    animation: none !important;
    transform: none !important;
  }
}
