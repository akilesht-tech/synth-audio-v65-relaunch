  transition: all 0.15s ease;
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.4);
}
.cardplay svg {
  width: 13px;
  height: 13px;
  fill: currentColor;
  stroke: none;
}
.card:hover .cardplay, .card:focus-within .cardplay {
  opacity: 1;
  transform: translateY(0);
}

.dots {
  position: absolute;
  right: 6px;
  top: 6px;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  display: grid;
  place-items: center;
  opacity: 0;
  transition: opacity 0.15s ease;
}
.dots svg {
  width: 13px;
  height: 13px;
}
.card:hover .dots {
  opacity: 1;
}

.card .title {
  font-size: 13.5px;
  font-weight: 600;
  margin-top: 7px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #fff;
}
.card .meta {
  font-size: 12px;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 1px;
}

.createPlaylistCard {
  border: 1.5px dashed rgba(var(--accent-rgb, 125, 59, 102), 0.3);
