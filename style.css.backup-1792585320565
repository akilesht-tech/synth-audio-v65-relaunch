  background: rgba(var(--accent-rgb, 125, 59, 102), 0.025);
  cursor: pointer;
  transition: all 0.15s ease;
}
.dropZone:hover, .dropZone.dragging {
  border-color: var(--accent-purple);
  background: rgba(var(--accent-rgb, 125, 59, 102), 0.06);
}
.dropZone .uploadIcon {
  width: 40px;
  height: 40px;
  margin: 0 auto 8px;
  border-radius: 50%;
  background: rgba(var(--accent-rgb, 125, 59, 102), 0.12);
  color: var(--accent-purple-light);
  display: grid;
  place-items: center;
}
.dropZone .uploadIcon svg {
  width: 18px;
  height: 18px;
}
.dropZone h3 {
  font-size: 13.5px;
  font-weight: 600;
  margin-bottom: 2px;
}
.dropZone p {
  font-size: 11.5px;
  color: var(--text-secondary);
}
.dropHint {
  font-size: 10.5px;
  color: var(--text-muted);
  display: block;
  margin-top: 3px;
}

.selectedAudio {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 10px;
  padding: 8px 12px;
