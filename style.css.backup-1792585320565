  border-radius: var(--radius-sm);
}
.selectedAudio.hidden {
  display: none !important;
}
.selectedIcon {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: var(--accent-purple);
  color: #fff;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}
.selectedIcon svg {
  width: 12px;
  height: 12px;
  fill: currentColor;
}
.selectedAudio b {
  font-size: 12px;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.selectedAudio small {
  font-size: 10.5px;
  color: var(--text-muted);
}
.selectedAudio button {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  color: var(--text-muted);
  display: grid;
  place-items: center;
}
.selectedAudio button:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.1);
}

.artworkNote {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  background: rgba(16, 185, 129, 0.06);
  border: 1px solid rgba(16, 185, 129, 0.2);
}
.artworkCheck {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.2);
  color: var(--accent-emerald);
  font-weight: 700;
  font-size: 10.5px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}
.artworkNote b {
  font-size: 11px;
  display: block;
  color: #fff;
}
.artworkNote small {
  font-size: 10px;
  color: var(--text-secondary);
}

.advancedUpload {
  margin-top: 10px;
  border-top: 1px solid var(--border-subtle);
  padding-top: 8px;
}
.advancedUpload summary {
  cursor: pointer;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 3px 0;
}
.twocol {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}
.fieldLabel {
  display: block;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-secondary);
  margin-top: 6px;
}
.optional {
  font-size: 9.5px;
  color: var(--text-muted);
  font-weight: 400;
}
.fieldLabel input {
  display: block;
  width: 100%;
  margin-top: 3px;
  padding: 7px 9px;
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  color: #fff;
  font-size: 12px;
}
.fieldLabel input:focus {
  border-color: var(--accent-purple);
}

.publishBtn {
  margin-top: 12px;
  min-height: 38px;
}
.publishBtn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.uploadProgress {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  font-weight: 600;
  margin-top: 8px;
}
.progressBar {
  width: 100%;
  height: 4px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.1);
  margin-top: 4px;
  overflow: hidden;
}
.progressBar i {
  display: block;
  height: 100%;
  width: 0%;
  background: var(--accent-purple);
  transition: width 0.15s ease;
}

.adminEmpty {
  text-align: center;
  padding: 28px 14px;
  color: var(--text-secondary);
}
.adminEmpty h3 {
  font-size: 13.5px;
  color: #fff;
  margin-bottom: 3px;
}

/* ==========================================================================
   MODALS, DIALOGS & OWNER GATE
   ========================================================================== */

.modal {
  position: fixed !important;
  inset: 0 !important;
  background: rgba(0, 0, 0, 0.75) !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
  z-index: 10000 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 14px !important;
}

.modalbox {
  width: min(460px, 100%) !important;
  max-height: 86vh !important;
  overflow-y: auto !important;
  background: var(--glass-modal) !important;
  backdrop-filter: blur(28px) saturate(190%) !important;
  -webkit-backdrop-filter: blur(28px) saturate(190%) !important;
  border: 1px solid var(--glass-border-medium) !important;
  border-radius: var(--radius-lg) !important;
  padding: 20px !important;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75), var(--glass-shadow-glow), var(--glass-highlight) !important;
}

.modalTitle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.modalTitle h3 {
  font-size: 15px;
  font-weight: 700;
  color: #fff;
}
.modalClose {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  display: grid;
  place-items: center;
  color: var(--text-secondary);
  transition: all 0.15s ease;
}
.modalClose:hover {
  color: #fff;
  background: rgba(255, 255, 255, 0.12);
}
.modalClose svg {
  width: 14px;
  height: 14px;
}

/* Owner Gate Box */
.ownerBox {
  width: min(360px, 100%) !important;
  text-align: center;
  position: relative;
}
.ownerIcon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(var(--accent-rgb, 125, 59, 102), 0.14);
  color: var(--accent-purple-light);
  display: grid;
  place-items: center;
  margin: 0 auto 8px;
}
.ownerIcon svg {
  width: 20px;
  height: 20px;
}
.ownerKicker {
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--accent-purple-light);
  letter-spacing: 0.05em;
  display: block;
}
.ownerBox h2 {
  font-size: 17px;
  font-weight: 700;
  margin: 2px 0 4px;
}
.ownerBox p {
  font-size: 11.5px;
  color: var(--text-secondary);
  margin-bottom: 12px;
}
.ownerBox .fieldLabel {
  text-align: left;
}
.ownerBox .field {
  width: 100%;
  margin-top: 3px;
  margin-bottom: 10px;
  padding: 8px 11px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  color: #fff;
  font-size: 12.5px;
}
.ownerBox .field:focus {
  border-color: var(--accent-purple);
}
.formMsg {
  font-size: 11px;
  color: var(--accent-danger);
  margin-top: 6px;
}

/* Standard Buttons */
.primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: var(--radius-sm);
  background: var(--grad-primary);
  color: #fff;
  font-size: 12.5px;
  font-weight: 600;
  transition: all 0.15s ease;
}
.primary:hover {
  filter: brightness(1.08);
}
.secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  color: var(--text-main);
  font-size: 12.5px;
  font-weight: 500;
  transition: all 0.15s ease;
}
.secondary:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--border-medium);
}
.wide {
  width: 100%;
}

/* Toast */
.toast {
  position: fixed;
  right: 16px;
  bottom: 74px;
  background: #161824;
  border: 1px solid var(--border-medium);
  padding: 7px 13px;
  border-radius: var(--radius-sm);
  z-index: 20000;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6);
  opacity: 0;
  transform: translateY(6px);
  transition: all 0.18s ease;
  pointer-events: none;
  font-size: 12px;
  font-weight: 600;
}
.toast.show {
  opacity: 1;
  transform: translateY(0);
}

/* Auth / Login Page */
.loginMode {
  overflow: hidden;
}
.login {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 16px;
  background: radial-gradient(circle at 50% 20%, #1e1333 0%, #08090d 65%);
}
.loginbox {
  width: min(370px, 100%);
  background: var(--glass-modal);
  backdrop-filter: blur(28px) saturate(190%);
  -webkit-backdrop-filter: blur(28px) saturate(190%);
  border: 1px solid var(--glass-border-medium);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.70), var(--glass-shadow-glow), var(--glass-highlight);
  position: relative;
}
.welcomeMark {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}
.welcomeMark span {
  font-family: var(--font-display);
  font-size: 12.5px;
  font-weight: 700;
  color: var(--accent-purple-light);
}
.welcomeBars {
  display: flex;
  align-items: flex-end;
  gap: 2px;
  height: 14px;
}
.welcomeBars i {
  display: block;
  width: 2.5px;
  background: var(--accent-purple);
  border-radius: 1px;
  animation: wavePulse 0.9s ease-in-out infinite alternate;
}
.welcomeBars i:nth-child(1) { height: 40%; }
.welcomeBars i:nth-child(2) { height: 80%; animation-delay: 0.15s; }
.welcomeBars i:nth-child(3) { height: 100%; animation-delay: 0.3s; }
.welcomeBars i:nth-child(4) { height: 60%; animation-delay: 0.45s; }
.welcomeBars i:nth-child(5) { height: 30%; animation-delay: 0.6s; }

.loginGlow {
  position: absolute;
  top: -30px;
  left: 50%;
  transform: translateX(-50%);
  width: 180px;
  height: 90px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--accent-rgb, 125, 59, 102), 0.25) 0%, transparent 70%);
  pointer-events: none;
}
.authBtn {
  margin-top: 4px;
}

.loginbox h1 {
  font-size: 19px;
  font-weight: 700;
  margin: 0 0 3px;
}
.loginbox p.sub {
  font-size: 11.5px;
  color: var(--text-secondary);
  margin-bottom: 14px;
}
.authTabs {
  display: flex;
  background: rgba(255, 255, 255, 0.035);
  border-radius: var(--radius-sm);
  padding: 3px;
  margin-bottom: 12px;
}
.authTabs button {
  flex: 1;
  padding: 5px;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--text-secondary);
  border-radius: 4px;
}
.authTabs button.active {
  background: var(--accent-purple);
  color: #fff;
}
.loginbox input.field {
  width: 100%;
  padding: 8px 11px;
  margin-bottom: 9px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  color: #fff;
  font-size: 12.5px;
}
.loginbox input.field:focus {
  border-color: var(--accent-purple);
}
.loginHint {
  font-size: 10.5px;
  color: var(--text-muted);
  text-align: center;
  margin-top: 8px;
}

/* Hide mobile elements by default */
.mobileNav, .mobileMoreMenu {
  display: none;
}

/* ==========================================================================
   RESPONSIVE MEDIA QUERIES
   Tested across 360, 390, 430, 768, 1024, 1280, 1440, 1920
   ========================================================================== */

