  color: #fff;
}
.adminDeleteBtn svg {
  width: 12px;
  height: 12px;
}

.adminActivityList {
  display: flex;
  flex-direction: column;
  gap: 3px;
  max-height: 420px;
  overflow-y: auto;
}

/* Upload Dropzone */
.uploadBox {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.easyUpload {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.dropZone {
  border: 1.5px dashed rgba(var(--accent-rgb, 125, 59, 102), 0.3);
  border-radius: var(--radius-md);
  padding: 22px 14px;
